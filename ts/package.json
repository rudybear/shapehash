{
  "name": "shapehash",
  "version": "1.0.0-rc.1",
  "description": "ShapeHash: a BlurHash-style placeholder string for 3D assets (decoder, encoder, GLB export)",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "default": "./dist/index.js" },
    "./decode": { "types": "./dist/types/decode.d.ts", "default": "./dist/decode.js" },
    "./gltf": { "types": "./dist/types/adapters/gltf.d.ts", "default": "./dist/gltf.js" },
    "./node": { "types": "./dist/types/adapters/node.d.ts", "default": "./dist/node.js" }
  },
  "bin": { "shapehash": "./dist/cli.js" },
  "files": ["dist", "src"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "node build.mjs",
    "test": "node build.mjs && node --test \"dist/test/*.test.js\"",
    "demo": "node build.mjs && node demo/serve.mjs"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "three": "^0.170.0",
    "typescript": "^5.6.0"
  }
}
